generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id                Int        @id @default(autoincrement())
  name              String     @db.VarChar(255)
  address           String?
  zone              String?    @db.VarChar(100)
  latitude          Decimal?   @db.Decimal(10, 8)
  longitude         Decimal?   @db.Decimal(11, 8)
  average_prep_time Int?       @default(20)
  rating            Decimal?   @db.Decimal(3, 2)
  created_at        DateTime?  @default(now()) @db.Timestamp(6)
  deliveries        Delivery[]

  @@map("restaurants")
}

model Rider {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(255)
  phone             String?             @db.VarChar(20)
  vehicle_type      String?             @db.VarChar(50)
  zone              String?             @db.VarChar(100)
  rating            Decimal?            @db.Decimal(3, 2)
  status            String?             @default("active") @db.VarChar(50)
  total_deliveries  Int?                @default(0)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  deliveries        Delivery[]
  rider_assignments rider_assignments[]

  @@map("riders")
}

model Delivery {
  id                     Int                 @id @default(autoincrement())
  order_id               String              @unique @db.VarChar(100)
  customer_id            Int?
  restaurant_id          Int?
  rider_id               Int?
  order_time             DateTime            @db.Timestamp(6)
  promised_delivery_time DateTime            @db.Timestamp(6)
  actual_delivery_time   DateTime?           @db.Timestamp(6)
  order_value            Decimal?            @db.Decimal(10, 2)
  delivery_distance      Decimal?            @db.Decimal(6, 2)
  status                 String?             @default("pending") @db.VarChar(50)
  is_sla_violated        Boolean?            @default(false)
  delay_minutes          Int?                @default(0)
  zone                   String?             @db.VarChar(100)
  created_at             DateTime?           @default(now()) @db.Timestamp(6)
  complaints             Complaint[]
  customers              customers?          @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  restaurants            Restaurant?         @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  riders                 Rider?              @relation(fields: [rider_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refunds                Refund[]
  rider_assignments      rider_assignments[]

  @@index([order_time], map: "idx_deliveries_order_time")
  @@index([is_sla_violated], map: "idx_deliveries_sla_violated")
  @@index([status], map: "idx_deliveries_status")
  @@index([zone], map: "idx_deliveries_zone")
=======
  id                 String    @id @default(uuid())
  orderId            String    @unique
  restaurantId       String
  riderId            String
  customerZone       String
  assignedAt         DateTime
  pickedAt           DateTime?
  deliveredAt        DateTime?
  promisedTime       DateTime
  actualDeliveryTime DateTime?
  slaBreached        Boolean   @default(false)
  distanceKm         Float
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rider      Rider      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  complaint  Complaint?
  refund     Refund?

  @@index([orderId])
  @@index([restaurantId])
  @@index([riderId])
  @@index([customerZone])
  @@index([assignedAt])
  @@index([promisedTime])
  @@index([slaBreached])
  @@index([createdAt])
  @@index([customerZone, assignedAt, slaBreached])
  @@index([restaurantId, slaBreached])
  @@index([riderId, slaBreached])
  @@map("deliveries")
}

model Complaint {
  id             Int        @id @default(autoincrement())
  delivery_id    Int?
  customer_id    Int?
  complaint_type String?    @db.VarChar(100)
  complaint_text String?
  severity       String?    @db.VarChar(50)
  status         String?    @default("open") @db.VarChar(50)
  filed_at       DateTime?  @default(now()) @db.Timestamp(6)
  resolved_at    DateTime?  @db.Timestamp(6)
  customers      customers? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deliveries     Delivery?  @relation(fields: [delivery_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([delivery_id], map: "idx_complaints_delivery")
  @@map("complaints")
}

model Refund {
  id            Int        @id @default(autoincrement())
  delivery_id   Int?
  customer_id   Int?
  refund_amount Decimal?   @db.Decimal(10, 2)
  refund_reason String?    @db.VarChar(255)
  refund_type   String?    @db.VarChar(50)
  processed_at  DateTime?  @default(now()) @db.Timestamp(6)
  customers     customers? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deliveries    Delivery?  @relation(fields: [delivery_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([delivery_id], map: "idx_refunds_delivery")
  @@map("refunds")
}

model customers {
  id         Int         @id @default(autoincrement())
  name       String      @db.VarChar(255)
  phone      String?     @db.VarChar(20)
  email      String?     @db.VarChar(255)
  address    String?
  latitude   Decimal?    @db.Decimal(10, 8)
  longitude  Decimal?    @db.Decimal(11, 8)
  created_at DateTime?   @default(now()) @db.Timestamp(6)
  complaints Complaint[]
  deliveries Delivery[]
  refunds    Refund[]
}

model refresh_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  token      String    @db.VarChar(500)
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_refresh_tokens_user")
}

model rider_assignments {
  id                       Int       @id @default(autoincrement())
  delivery_id              Int?
  rider_id                 Int?
  assigned_at              DateTime  @db.Timestamp(6)
  accepted_at              DateTime? @db.Timestamp(6)
  reached_restaurant_at    DateTime? @db.Timestamp(6)
  picked_up_at             DateTime? @db.Timestamp(6)
  assignment_delay_minutes Int?      @default(0)
  created_at               DateTime? @default(now()) @db.Timestamp(6)
  deliveries               Delivery? @relation(fields: [delivery_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  riders                   Rider?    @relation(fields: [rider_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([delivery_id], map: "idx_rider_assignments_delivery")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id             Int              @id @default(autoincrement())
  email          String           @unique @db.VarChar(255)
  password_hash  String           @db.VarChar(255)
  full_name      String           @db.VarChar(255)
  role           String?          @default("analyst") @db.VarChar(50)
  avatar         String?          @db.VarChar(500)
  age            Int?
  gender         String?          @db.VarChar(20)
  height         Decimal?         @db.Decimal(5, 2)
  weight         Decimal?         @db.Decimal(5, 2)
  fitness_goal   String?          @db.VarChar(50)
  activity_level String?          @db.VarChar(50)
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @default(now()) @db.Timestamp(6)
  last_login     DateTime?        @db.Timestamp(6)
  is_active      Boolean?         @default(true)
  deleted_at     DateTime?        @db.Timestamp(6)
  refresh_tokens refresh_tokens[]

  @@index([email], map: "idx_users_email")
}
