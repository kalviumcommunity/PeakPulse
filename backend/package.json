    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.11.3",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
